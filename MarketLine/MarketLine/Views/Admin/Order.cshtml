@model MarketLine.Models.Order
@{
    ViewData["Title"] = Model.OrderNumber;
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">Поръчка @Model.OrderNumber</h1>
    <partial name="_AdminNav" />

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <p><strong>Клиент:</strong> @Model.FirstName @Model.LastName, @Model.Email, @Model.Phone</p>
            <p><strong>Адрес:</strong> @Model.Address, @Model.City, @Model.PostalCode</p>
            <p><strong>Доставка:</strong> @Model.Courier, @Model.DeliveryMethod</p>
            <p><strong>Плащане:</strong> @Model.PaymentMethod — @Model.PaymentStatus</p>
            <p>
                <strong>Статус:</strong>
                <span class="badge @OrderStatuses.BadgeClass(Model.Status)">
                    @OrderStatuses.Normalize(Model.Status)
                </span>
            </p>
            <p class="mb-0"><strong>Сума:</strong> @Model.Total.ToString("C2")</p>
        </div>
    </div>

    <h5 class="mb-3">Проследяване</h5>
    <partial name="_OrderTracker" model="Model" />

    <table class="table align-middle mb-4">
        <thead>
            <tr>
                <th>Продукт</th>
                <th>Количество</th>
                <th>Цена</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.Name</td>
                    <td>@line.Quantity</td>
                    <td>@line.LineTotal.ToString("C2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex flex-wrap gap-2">
        <form asp-action="SetOrderStatus" method="post" class="d-flex gap-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <select name="status" class="form-select">
                @foreach (var status in OrderStatuses.All)
                {
                    <option value="@status" selected="@(status == OrderStatuses.Normalize(Model.Status))">@status</option>
                }
            </select>
            <button type="submit" class="btn btn-success">Запази статус</button>
        </form>

        @if (OrderStatuses.Normalize(Model.Status) != OrderStatuses.Cancelled)
        {
            <form asp-action="CancelOrder" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-danger">Откажи поръчка</button>
            </form>
        }

        <form asp-action="SetPaymentStatus" method="post" class="d-flex gap-2">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="hidden" name="returnAction" value="Order" />
            <select name="paymentStatus" class="form-select">
                @foreach (var status in PaymentStatuses.All)
                {
                    <option value="@status" selected="@(status == Model.PaymentStatus)">@status</option>
                }
            </select>
            <button type="submit" class="btn btn-outline-secondary">Запази плащане</button>
        </form>
    </div>
</div>
