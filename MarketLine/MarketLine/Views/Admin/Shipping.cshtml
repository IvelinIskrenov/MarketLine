@model MarketLine.Models.ShippingSettings
@{
    ViewData["Title"] = "Доставки";
    var couriers = ViewBag.Couriers as List<MarketLine.Models.Courier> ?? new List<MarketLine.Models.Courier>();
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">Доставки</h1>
    <partial name="_AdminNav" />

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="mb-3">Правила за доставка</h5>
            <form asp-action="SaveShipping" method="post" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label">Стандартна цена</label>
                    <input asp-for="DefaultPrice" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Безплатна доставка над</label>
                    <input asp-for="FreeOver" class="form-control" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-success w-100">Запази правилата</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="mb-3">Нов куриер</h5>
            <form asp-action="AddCourier" method="post" class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label">Име</label>
                    <input name="Name" class="form-control" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label">Цена</label>
                    <input name="Price" type="number" step="0.01" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-success w-100">Добави</button>
                </div>
            </form>
        </div>
    </div>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>Куриер</th>
                <th>Цена</th>
                <th>Статус</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var courier in couriers)
            {
                <tr>
                    <td>@courier.Name</td>
                    <td>@courier.Price.ToString("C2")</td>
                    <td>@(courier.IsActive ? "Активен" : "Спрян")</td>
                    <td>
                        <form asp-action="ToggleCourier" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@courier.Id" />
                            <button class="btn btn-sm btn-outline-secondary">@(courier.IsActive ? "Спри" : "Активирай")</button>
                        </form>
                        <form asp-action="DeleteCourier" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@courier.Id" />
                            <button class="btn btn-sm btn-outline-danger">Изтрий</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
