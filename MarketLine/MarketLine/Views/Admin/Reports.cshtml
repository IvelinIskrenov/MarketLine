@using MarketLine.Services
@model SalesReport
@{
    ViewData["Title"] = "Отчети";
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">Отчети за продажби</h1>
    <partial name="_AdminNav" />

    <div class="mb-3 d-flex flex-wrap gap-2">
        @foreach (var preset in SalesReportPeriods.Presets)
        {
            <a asp-action="Reports" asp-route-period="@preset.Key" class="btn btn-sm @(Model.Period == preset.Key ? "btn-success" : "btn-outline-secondary")">@preset.Label</a>
        }
    </div>

    <form asp-action="Reports" method="get" class="row g-2 align-items-end mb-4">
        <input type="hidden" name="period" value="@SalesReportPeriods.Custom" />
        <div class="col-md-3">
            <label class="form-label" for="from">От дата</label>
            <input id="from" name="from" type="date" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="to">До дата</label>
            <input id="to" name="to" type="date" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-success">Покажи период</button>
        </div>
        <div class="col-md-3 text-md-end">
            <a asp-action="ExportReports"
               asp-route-period="@Model.Period"
               asp-route-from="@(Model.Period == SalesReportPeriods.Custom ? Model.From.ToString("yyyy-MM-dd") : null)"
               asp-route-to="@(Model.Period == SalesReportPeriods.Custom ? Model.To.ToString("yyyy-MM-dd") : null)"
               class="btn btn-outline-secondary">Изтегли CSV</a>
        </div>
    </form>

    <p class="text-muted">Период: @Model.PeriodLabel</p>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Оборот</h6>
                    <p class="display-6 mb-0">@Model.Turnover.Euro()</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Поръчки</h6>
                    <p class="display-6 mb-0">@Model.OrderCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Средна поръчка</h6>
                    <p class="display-6 mb-0">@Model.AverageOrder.Euro()</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Платено</h6>
                    <p class="display-6 mb-0">@Model.PaidTurnover.Euro()</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Продадени бройки</h6>
                    <p class="display-6 mb-0">@Model.ItemsSold</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Отказани</h6>
                    <p class="display-6 mb-0">@Model.CancelledCount</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Отстъпки</h6>
                    <p class="display-6 mb-0">@Model.DiscountTotal.Euro()</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h6 class="text-muted">Доставки</h6>
                    <p class="display-6 mb-0">@Model.ShippingTotal.Euro()</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="mb-3">По периоди</h5>
            @if (Model.Periods.Count == 0)
            {
                <p class="text-muted mb-0">Няма данни за избрания период.</p>
            }
            else
            {
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Период</th>
                            <th>Поръчки</th>
                            <th>Оборот</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bucket in Model.Periods)
                        {
                            <tr>
                                <td>@bucket.Label</td>
                                <td>@bucket.OrderCount</td>
                                <td>@bucket.Turnover.Euro()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="mb-3">Продукти</h5>
            @if (Model.Products.Count == 0)
            {
                <p class="text-muted mb-0">Няма продажби за избрания период.</p>
            }
            else
            {
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Продукт</th>
                            <th>Количество</th>
                            <th>Оборот</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model.Products)
                        {
                            <tr>
                                <td>@product.Name</td>
                                <td>@product.Quantity</td>
                                <td>@product.Total.Euro()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h5 class="mb-3">Поръчки</h5>
            @if (Model.Orders.Count == 0)
            {
                <p class="text-muted mb-0">Няма поръчки за избрания период.</p>
            }
            else
            {
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Номер</th>
                            <th>Клиент</th>
                            <th>Дата</th>
                            <th>Статус</th>
                            <th>Плащане</th>
                            <th>Сума</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td>@order.OrderNumber</td>
                                <td>@order.FirstName @order.LastName</td>
                                <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @OrderStatuses.BadgeClass(order.Status)">
                                        @OrderStatuses.Normalize(order.Status)
                                    </span>
                                </td>
                                <td>@order.PaymentStatus</td>
                                <td>@order.Total.Euro()</td>
                                <td><a asp-action="Order" asp-route-id="@order.Id">Отвори</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
