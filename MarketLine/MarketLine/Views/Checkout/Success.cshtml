@model MarketLine.Models.Order
@{
    ViewData["Title"] = "Успешна поръчка";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="alert alert-success text-center" role="alert">
                Поръчката е направена успешно.
            </div>

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3 text-center">Благодарим ви!</h1>
                    <p class="text-center mb-2">Номер на поръчка: <strong>@Model.OrderNumber</strong></p>
                    <p class="text-center mb-3">
                        Статус:
                        <span class="badge @OrderStatuses.BadgeClass(Model.Status)">
                            @OrderStatuses.Normalize(Model.Status)
                        </span>
                    </p>
                    <partial name="_OrderTracker" model="Model" />

                    <h5 class="mb-3">Данни за доставка</h5>
                    <p class="mb-1">@Model.FirstName @Model.LastName</p>
                    <p class="mb-1">@Model.Address, @Model.PostalCode @Model.City</p>
                    <p class="mb-1">@Model.Phone · @Model.Email</p>
                    <p class="mb-1">@Model.Courier · @Model.DeliveryMethod</p>
                    <p class="mb-3">Плащане: @Model.PaymentMethod</p>

                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Продукт</th>
                                <th>Количество</th>
                                <th>Общо</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Lines)
                            {
                                <tr>
                                    <td>
                                        @line.Name
                                        @if (!string.IsNullOrWhiteSpace(line.VariantLabel))
                                        {
                                            <div class="text-muted small">@line.VariantLabel</div>
                                        }
                                    </td>
                                    <td>@line.Quantity</td>
                                    <td>@line.LineTotal.ToString("C2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="d-flex justify-content-between h5">
                        <span>Платена сума</span>
                        <strong>@Model.Total.ToString("C2")</strong>
                    </div>

                    <div class="text-center mt-4 d-flex flex-wrap justify-content-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Profile" asp-action="Order" asp-route-orderNumber="@Model.OrderNumber" class="btn btn-success">Проследи поръчката</a>
                            <partial name="_ReorderButton" model="Model" />
                        }
                        <a asp-controller="Item" asp-action="Index" class="btn btn-custom-green">Към продуктите</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
