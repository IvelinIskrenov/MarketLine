@model IEnumerable<MarketLine.Models.Item>
@{
    ViewData["Title"] = "Продукти";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">Управление на продукти</h1>
    <partial name="_AdminNav" />

    <p>
        <a asp-action="Create" class="btn btn-success">Добави продукт</a>
    </p>

    <table class="table align-middle">
        <thead>
            <tr>
                <th>Име</th>
                <th>Марка</th>
                <th>Категория</th>
                <th>Цена</th>
                <th>Наличност</th>
                <th>Отстъпка</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.name</td>
                    <td>@(item.Brand)</td>
                    <td>@(item.category?.Name)</td>
                    <td>@item.price.ToString("C2")</td>
                    <td>
                        @item.AvailableStock
                        <div class="mt-1">@await Html.PartialAsync("_StockStatus", item)</div>
                    </td>
                    <td>@item.discount %</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.id">Редакция</a>
                        <a asp-action="Delete" asp-route-id="@item.id" class="ms-2">Изтрий</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
