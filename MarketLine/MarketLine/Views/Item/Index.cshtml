@model MarketLine.Models.ItemCatalogViewModel
@{
    ViewData["Title"] = "Index";
    var query = Model.Query;
    var currentSort = string.IsNullOrWhiteSpace(query.Sort) ? "newest" : query.Sort;
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">🛒 Products</h1>

    <div class="row">
        <aside class="col-lg-3 mb-4">
            <form method="get" asp-action="Index" class="catalog-filters card shadow-sm border-0">
                <div class="card-body">
                    <h2 class="h5 mb-3">Филтри</h2>

                    <div class="mb-3">
                        <label class="form-label" for="catalog-search">Търсене</label>
                        <input id="catalog-search"
                               type="search"
                               name="searchTerm"
                               class="form-control search-input"
                               value="@query.SearchTerm"
                               placeholder="Име или описание"
                               autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="catalog-category">Категория</label>
                        <select id="catalog-category" name="category" class="form-select">
                            <option value="">Всички</option>
                            @foreach (var category in Model.Categories)
                            {
                                if (string.Equals(query.Category, category.Name, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@category.Name" selected>@category.Name</option>
                                }
                                else
                                {
                                    <option value="@category.Name">@category.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Цена</label>
                        <div class="d-flex gap-2">
                            <input type="number"
                                   name="minPrice"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   placeholder="От"
                                   value="@query.MinPrice" />
                            <input type="number"
                                   name="maxPrice"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   placeholder="До"
                                   value="@query.MaxPrice" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="catalog-brand">Марка</label>
                        <select id="catalog-brand" name="brand" class="form-select">
                            <option value="">Всички</option>
                            @foreach (var brand in Model.Brands)
                            {
                                if (string.Equals(query.Brand, brand, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@brand" selected>@brand</option>
                                }
                                else
                                {
                                    <option value="@brand">@brand</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="catalog-feature">Характеристика</label>
                        <select id="catalog-feature" name="feature" class="form-select">
                            <option value="">Всички</option>
                            @foreach (var feature in Model.Features)
                            {
                                if (string.Equals(query.Feature, feature, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@feature" selected>@feature</option>
                                }
                                else
                                {
                                    <option value="@feature">@feature</option>
                                }
                            }
                        </select>
                    </div>

                    <input type="hidden" name="sort" value="@currentSort" />

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-custom-green">Приложи</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Изчисти</a>
                    </div>
                </div>
            </form>
        </aside>

        <div class="col-lg-9">
            <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <input type="hidden" name="searchTerm" value="@query.SearchTerm" />
                <input type="hidden" name="category" value="@query.Category" />
                <input type="hidden" name="minPrice" value="@query.MinPrice" />
                <input type="hidden" name="maxPrice" value="@query.MaxPrice" />
                <input type="hidden" name="brand" value="@query.Brand" />
                <input type="hidden" name="feature" value="@query.Feature" />
                <p class="mb-0 text-muted">Намерени продукти: @Model.Items.Count</p>
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0" for="catalog-sort">Сортиране</label>
                    <select id="catalog-sort" name="sort" class="form-select" style="width: auto;" onchange="this.form.submit()">
                        @if (currentSort == "newest")
                        {
                            <option value="newest" selected>Новост</option>
                        }
                        else
                        {
                            <option value="newest">Новост</option>
                        }
                        @if (currentSort == "price-asc")
                        {
                            <option value="price-asc" selected>Цена: ниска към висока</option>
                        }
                        else
                        {
                            <option value="price-asc">Цена: ниска към висока</option>
                        }
                        @if (currentSort == "price-desc")
                        {
                            <option value="price-desc" selected>Цена: висока към ниска</option>
                        }
                        else
                        {
                            <option value="price-desc">Цена: висока към ниска</option>
                        }
                        @if (currentSort == "popular")
                        {
                            <option value="popular" selected>Популярност</option>
                        }
                        else
                        {
                            <option value="popular">Популярност</option>
                        }
                    </select>
                </div>
            </form>

            @if (Model.Items.Count == 0)
            {
                <div class="alert alert-warning text-center" role="alert">
                    No quantity in this moment
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                    @foreach (var item in Model.Items)
                    {
                        var description = item.description ?? string.Empty;
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0">
                                <a asp-action="Details" asp-route-id="@item.id">
                                    <img src="@item.imageUrl" class="card-img-top" alt="@item.name" style="height: 200px; object-fit: cover;">
                                </a>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-truncate">
                                        <a asp-action="Details" asp-route-id="@item.id" class="text-decoration-none text-dark">
                                            @item.name
                                        </a>
                                    </h5>
                                    @if (!string.IsNullOrWhiteSpace(item.Brand))
                                    {
                                        <p class="text-muted small mb-1">@item.Brand</p>
                                    }

                                    <p class="card-text text-muted mb-2">
                                        <a asp-action="Details" asp-route-id="@item.id" class="text-decoration-none text-muted">
                                            @(description.Length > 70 ? description.Substring(0, 70) + "..." : description)
                                        </a>
                                    </p>
                                    <div class="mt-auto pt-2">
                                        <div class="price-container h4 mb-3">
                                            @if (item.discount != 0)
                                            {
                                                <del class="text-danger me-2">
                                                    @item.price.ToString("C2")
                                                </del>

                                                <strong class="text-dark">
                                                    @item.DiscountedPrice.ToString("C2")
                                                </strong>
                                            }
                                            else
                                            {
                                                <strong class="text-danger">
                                                    @item.price.ToString("C2")
                                                </strong>
                                            }
                                        </div>
                                        <form asp-controller="Cart" asp-action="Add" method="post">
                                            <input type="hidden" name="id" value="@item.id" />
                                            <button type="submit"
                                                    class="btn btn-custom-green w-60 d-inline-flex align-items-center justify-content-center"
                                                    style="width: 60%;">
                                                <img src="~/images/add-to-cart.png" alt="Cart" style="width: 20px; height: 20px;" class="me-2" />
                                                Add to Cart
                                            </button>
                                        </form>
                                        <div class="mt-2">
                                            @await Html.PartialAsync("_WishlistButton", item.id)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* Phone *@
<style>
    /* Ensures that images in maps are not too large on mobile */
    .card-img-top {
        max-height: 200px;
    }

    /* Adds a little indentation for better readability on mobile */
    @@media (max-width: 576px) {
        .container {
            padding-left: 10px;
            padding-right: 10px;
        }
    }
</style>
