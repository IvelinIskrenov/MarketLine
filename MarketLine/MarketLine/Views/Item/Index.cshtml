@model MarketLine.Models.ItemCatalogViewModel
@{
    ViewData["Title"] = T["nav.products"];
    var query = Model.Query;
    var currentSort = string.IsNullOrWhiteSpace(query.Sort) ? "newest" : query.Sort;
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">🛒 @T["nav.products"]</h1>

    @if (TempData["CartMessage"] != null)
    {
                    <div class="alert alert-success text-center" role="alert">@T.Content(TempData["CartMessage"] as string)</div>
    }
    @if (TempData["CartError"] != null)
    {
                    <div class="alert alert-warning text-center" role="alert">@T.Content(TempData["CartError"] as string)</div>
    }

    <div class="row">
        <aside class="col-lg-3 mb-4">
            <form method="get" asp-action="Index" class="catalog-filters card shadow-sm border-0">
                <div class="card-body">
                    <h2 class="h5 mb-3">@T["shop.filters"]</h2>

                    <div class="mb-3">
                        <label class="form-label" for="catalog-search">@T["shop.search"]</label>
                        <input id="catalog-search"
                               type="search"
                               name="searchTerm"
                               class="form-control search-input"
                               value="@query.SearchTerm"
                               placeholder="@T.Content("Име или описание")"
                               autocomplete="off" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="catalog-category">@T["shop.category"]</label>
                        <select id="catalog-category" name="category" class="form-select">
                            <option value="">@T["shop.all"]</option>
                            @foreach (var category in Model.Categories)
                            {
                                if (string.Equals(query.Category, category.Name, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@category.Name" selected>@T.Content(category.Name)</option>
                                }
                                else
                                {
                                    <option value="@category.Name">@T.Content(category.Name)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@T["shop.price"]</label>
                        <div class="d-flex gap-2">
                            <input type="number"
                                   name="minPrice"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   placeholder="@T["shop.from"]"
                                   value="@query.MinPrice" />
                            <input type="number"
                                   name="maxPrice"
                                   class="form-control"
                                   min="0"
                                   step="0.01"
                                   placeholder="@T["shop.to"]"
                                   value="@query.MaxPrice" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="catalog-brand">@T["shop.brand"]</label>
                        <select id="catalog-brand" name="brand" class="form-select">
                            <option value="">@T["shop.all"]</option>
                            @foreach (var brand in Model.Brands)
                            {
                                if (string.Equals(query.Brand, brand, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@brand" selected>@brand</option>
                                }
                                else
                                {
                                    <option value="@brand">@brand</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="catalog-feature">@T["shop.feature"]</label>
                        <select id="catalog-feature" name="feature" class="form-select">
                            <option value="">@T["shop.all"]</option>
                            @foreach (var feature in Model.Features)
                            {
                                if (string.Equals(query.Feature, feature, StringComparison.OrdinalIgnoreCase))
                                {
                                    <option value="@feature" selected>@T.Content(feature)</option>
                                }
                                else
                                {
                                    <option value="@feature">@T.Content(feature)</option>
                                }
                            }
                        </select>
                    </div>

                    <input type="hidden" name="sort" value="@currentSort" />

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-custom-green">@T["shop.apply"]</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">@T["shop.clear"]</a>
                    </div>
                </div>
            </form>
        </aside>

        <div class="col-lg-9">
            <form method="get" asp-action="Index" class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <input type="hidden" name="searchTerm" value="@query.SearchTerm" />
                <input type="hidden" name="category" value="@query.Category" />
                <input type="hidden" name="minPrice" value="@query.MinPrice" />
                <input type="hidden" name="maxPrice" value="@query.MaxPrice" />
                <input type="hidden" name="brand" value="@query.Brand" />
                <input type="hidden" name="feature" value="@query.Feature" />
                <p class="mb-0 text-muted">@T["shop.found"]: @Model.Items.Count</p>
                <div class="d-flex align-items-center gap-2">
                    <label class="form-label mb-0" for="catalog-sort">@T["shop.sort"]</label>
                    <select id="catalog-sort" name="sort" class="form-select" style="width: auto;" onchange="this.form.submit()">
                        @if (currentSort == "newest")
                        {
                            <option value="newest" selected>@T["shop.sort.newest"]</option>
                        }
                        else
                        {
                            <option value="newest">@T["shop.sort.newest"]</option>
                        }
                        @if (currentSort == "price-asc")
                        {
                            <option value="price-asc" selected>@T["shop.sort.priceAsc"]</option>
                        }
                        else
                        {
                            <option value="price-asc">@T["shop.sort.priceAsc"]</option>
                        }
                        @if (currentSort == "price-desc")
                        {
                            <option value="price-desc" selected>@T["shop.sort.priceDesc"]</option>
                        }
                        else
                        {
                            <option value="price-desc">@T["shop.sort.priceDesc"]</option>
                        }
                        @if (currentSort == "popular")
                        {
                            <option value="popular" selected>@T["shop.sort.popular"]</option>
                        }
                        else
                        {
                            <option value="popular">@T["shop.sort.popular"]</option>
                        }
                    </select>
                </div>
            </form>

            @if (Model.Items.Count == 0)
            {
                <div class="alert alert-warning text-center" role="alert">
                    @T["shop.empty"]
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
                    @foreach (var item in Model.Items)
                    {
                        var description = T.Content(item.description);
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0">
                                <a asp-action="Details" asp-route-id="@item.id">
                                    <img src="@item.imageUrl" class="card-img-top" alt="@T.Content(item.name)" style="height: 200px; object-fit: cover;">
                                </a>
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-truncate">
                                        <a asp-action="Details" asp-route-id="@item.id" class="text-decoration-none text-dark">
                                            @T.Content(item.name)
                                        </a>
                                    </h5>
                                    @if (!string.IsNullOrWhiteSpace(item.Brand))
                                    {
                                        <p class="text-muted small mb-1">@item.Brand</p>
                                    }

                                    <p class="card-text text-muted mb-2">
                                        <a asp-action="Details" asp-route-id="@item.id" class="text-decoration-none text-muted">
                                            @(description.Length > 70 ? description.Substring(0, 70) + "..." : description)
                                        </a>
                                    </p>
                                    <div class="mt-auto pt-2">
                                        <div class="price-container h4 mb-3">
                                            @if (item.discount != 0)
                                            {
                                                <del class="text-danger me-2">
                                                    @item.price.Euro()
                                                </del>

                                                <strong class="text-dark">
                                                    @item.DiscountedPrice.Euro()
                                                </strong>
                                            }
                                            else
                                            {
                                                <strong class="text-danger">
                                                    @item.price.Euro()
                                                </strong>
                                            }
                                        </div>
                                        <div class="mb-2">
                                            @await Html.PartialAsync("_StockStatus", item)
                                        </div>
                                        @if (item.IsSoldOut)
                                        {
                                            <a asp-action="Details"
                                               asp-route-id="@item.id"
                                               asp-fragment="stock-alert"
                                               class="btn btn-custom-green w-60 d-inline-flex align-items-center justify-content-center"
                                               style="width: 60%;">
                                                @T["shop.notifyMe"]
                                            </a>
                                        }
                                        else if (item.HasMultipleVariants)
                                        {
                                            <a asp-action="Details"
                                               asp-route-id="@item.id"
                                               class="btn btn-custom-green w-60 d-inline-flex align-items-center justify-content-center"
                                               style="width: 60%;">
                                                @T["shop.chooseVariant"]
                                            </a>
                                        }
                                        else
                                        {
                                            <form asp-controller="Cart" asp-action="Add" method="post">
                                                <input type="hidden" name="id" value="@item.id" />
                                                @if (item.Variants.Count == 1)
                                                {
                                                    <input type="hidden" name="variantId" value="@item.Variants[0].Id" />
                                                }
                                                <button type="submit"
                                                        class="btn btn-custom-green w-60 d-inline-flex align-items-center justify-content-center"
                                                        style="width: 60%;">
                                                    <img src="~/images/add-to-cart.png" alt="Cart" style="width: 20px; height: 20px;" class="me-2" />
                                                    @T["shop.addToCart"]
                                                </button>
                                            </form>
                                        }
                                        <div class="mt-2">
                                            @await Html.PartialAsync("_WishlistButton", item.id)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* Phone *@
<style>
    /* Ensures that images in maps are not too large on mobile */
    .card-img-top {
        max-height: 200px;
    }

    /* Adds a little indentation for better readability on mobile */
    @@media (max-width: 576px) {
        .container {
            padding-left: 10px;
            padding-right: 10px;
        }
    }
</style>
