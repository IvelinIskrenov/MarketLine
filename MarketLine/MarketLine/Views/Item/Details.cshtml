@model MarketLine.Models.Item

@{
    ViewData["Title"] = T["shop.details"];
    var selectedVariant = Model.Variants.FirstOrDefault(variant => variant.StockQuantity > 0) ?? Model.Variants.FirstOrDefault();
}

<div class="container mt-4">
    <h4>@T["shop.details"]</h4>
    <hr />

    @if (Model.IsScheduled)
    {
        <div class="alert alert-info" role="alert">
            Този продукт е планиран за @ItemPublishing.ToLocalDisplay(Model.PublishedAt) и още не се вижда в каталога.
        </div>
    }

    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-warning" role="alert">@T.Content(TempData["CartError"] as string)</div>
    }
    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-success" role="alert">@T.Content(TempData["CartMessage"] as string)</div>
    }

    <div class="row">
        <div class="col-md-5 mb-4">
            @if (!string.IsNullOrEmpty(Model.imageUrl))
            {
                <img src="@Model.imageUrl" class="img-fluid rounded shadow" alt="@T.Content(Model.name)" />
            }
            else
            {
                <img src="/images/no-image.png" class="img-fluid rounded shadow" alt="No image available" />
            }
        </div>

        <div class="col-md-7">
            <h3>@T.Content(Model.name)</h3>
            <p class="text-muted mb-1">@T["shop.category"]: <span class="badge bg-secondary">@T.Content(Model.category?.Name)</span></p>
            @if (!string.IsNullOrWhiteSpace(Model.Brand))
            {
                <p class="text-muted mb-2">@T["shop.brand"]: <span class="badge bg-success">@Model.Brand</span></p>
            }
            @if (Model.FeatureTags.Count > 0)
            {
                <p class="mb-3">
                    @foreach (var tag in Model.FeatureTags)
                    {
                        <span class="badge bg-light text-dark border me-1">@T.Content(tag)</span>
                    }
                </p>
            }

            <div class="price-section mb-3">
                @if (Model.discount != 0)
                {
                    <del class="h5 text-danger me-2">@Model.price.Euro()</del>
                    <strong class="h3 text-dark">@Model.DiscountedPrice.Euro()</strong>
                    <span class="badge bg-success ms-2">-@Model.discount%</span>
                }
                else
                {
                    <strong class="h3 text-danger">@Model.price.Euro()</strong>
                }
            </div>

            <hr />

            <dl class="row">
                <dt class="col-sm-4">@T["shop.description"]</dt>
                <dd class="col-sm-8">@T.Content(Model.description)</dd>

                <dt class="col-sm-4">@T["shop.stock"]</dt>
                <dd class="col-sm-8">
                    @await Html.PartialAsync("_StockStatus", Model)
                </dd>
            </dl>

            @if (Model.Variants.Count > 0)
            {
                <div class="mb-3">
                    <p class="fw-semibold mb-2">@T["shop.variants"]</p>
                    <ul class="list-unstyled small text-muted mb-0">
                        @foreach (var variant in Model.Variants)
                        {
                            <li>
                                @T.Content(variant.Label) —
                                @if (variant.IsSoldOut)
                                {
                                    <span class="text-danger">@T["shop.soldOut.short"]</span>
                                }
                                else if (variant.IsLowStock)
                                {
                                    <span class="text-warning">@T["shop.left"] @variant.StockQuantity @T["shop.pcs"]</span>
                                }
                                else
                                {
                                    <span>@variant.StockQuantity @T["shop.pcs"]</span>
                                }
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="mt-4">
                <form asp-controller="Cart" asp-action="Add" method="post" class="d-flex flex-wrap align-items-end gap-2">
                    <input type="hidden" name="id" value="@Model.id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    @if (Model.Variants.Count > 0)
                    {
                        <div>
                            <label class="form-label" for="variantId">@T["shop.variant"]</label>
                            <select id="variantId" name="variantId" class="form-select" @(Model.IsSoldOut ? "disabled" : null)>
                                @foreach (var variant in Model.Variants)
                                {
                                    if (variant.IsSoldOut)
                                    {
                                        <option value="@variant.Id" disabled>@T.Content(variant.Label) — @T["shop.soldOut.short"]</option>
                                    }
                                    else if (selectedVariant?.Id == variant.Id)
                                    {
                                        <option value="@variant.Id" selected>@T.Content(variant.Label) (@variant.StockQuantity @T["shop.pcs"])</option>
                                    }
                                    else
                                    {
                                        <option value="@variant.Id">@T.Content(variant.Label) (@variant.StockQuantity @T["shop.pcs"])</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    <div>
                        <label class="form-label" for="quantity">@T["shop.quantity"]</label>
                        <input id="quantity"
                               type="number"
                               name="quantity"
                               class="form-control"
                               value="1"
                               min="1"
                               max="@(selectedVariant?.StockQuantity ?? Model.AvailableStock)"
                               @(Model.IsSoldOut ? "disabled" : null) />
                    </div>
                    <button type="submit" class="btn btn-success btn-lg px-4 shadow-sm" @(Model.IsSoldOut ? "disabled" : null)>
                        <i class="bi bi-cart-plus-fill me-2"></i> @T["shop.addToCart"]
                    </button>
                </form>
                @if (Model.IsSoldOut)
                {
                    <p class="text-danger mt-2 mb-0">@T["shop.soldOutMsg"]</p>
                }
                else if (Model.IsLowStock)
                {
                    <p class="text-warning mt-2 mb-0">@T["shop.lowStockWarn"]</p>
                }
                @await Html.PartialAsync("_StockAlertForm", Model)
                <div class="mt-2">
                    @await Html.PartialAsync("_WishlistButton", Model.id)
                </div>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_ProductQuestions", Model)
</div>
