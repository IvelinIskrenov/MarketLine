@model MarketLine.Models.SitePage
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="mb-4 text-center">@Model.Title</h1>
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded mb-4" />
            }
            <div class="card shadow-sm border-0">
                <div class="card-body" style="white-space: pre-line;">@Model.Body</div>
            </div>
        </div>
    </div>
</div>
