@model MarketLine.Models.CartViewModel
@{
    ViewData["Title"] = T["cart.title"];
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">@T["cart.title"]</h1>

    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-success text-center" role="alert">@T.Content(TempData["CartMessage"] as string)</div>
    }
    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-warning text-center" role="alert">@T.Content(TempData["CartError"] as string)</div>
    }

    @if (Model.Lines.Count == 0)
    {
        <div class="alert alert-warning text-center" role="alert">
            @T["cart.empty"]
        </div>
        <div class="text-center">
            <a asp-controller="Item" asp-action="Index" class="btn btn-custom-green">@T["cart.toProducts"]</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>@T["cart.product"]</th>
                            <th>@T["cart.price"]</th>
                            <th>@T["cart.qty"]</th>
                            <th>@T["cart.total"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(line.ImageUrl))
                                        {
                                            <img src="@line.ImageUrl" alt="@T.Content(line.Name)" style="width: 70px; height: 70px; object-fit: cover;" class="me-3 rounded" />
                                        }
                                        <a asp-controller="Item" asp-action="Details" asp-route-id="@line.ItemId" class="text-decoration-none text-dark">
                                            @T.Content(line.Name)
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(line.VariantLabel))
                                        {
                                            <div class="text-muted small">@T.Content(line.VariantLabel)</div>
                                        }
                                    </div>
                                </td>
                                <td>@line.UnitPrice.Euro()</td>
                                <td>
                                    <form asp-action="Update" method="post" class="d-flex align-items-center">
                                        <input type="hidden" name="id" value="@line.ItemId" />
                                        <input type="hidden" name="variantId" value="@line.VariantId" />
                                        <input type="number"
                                               name="quantity"
                                               value="@line.Quantity"
                                               min="1"
                                               max="@line.StockQuantity"
                                               class="form-control"
                                               style="width: 80px;" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm ms-2">@T["cart.update"]</button>
                                    </form>
                                </td>
                                <td>@line.LineTotal.Euro()</td>
                                <td>
                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="id" value="@line.ItemId" />
                                        <input type="hidden" name="variantId" value="@line.VariantId" />
                                        <button type="submit" class="btn btn-link text-danger p-0">@T["cart.remove"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h5 class="mb-3">@T["cart.summary"]</h5>

                        <form asp-action="ApplyPromo" method="post" class="mb-3">
                            <label class="form-label">@T["cart.promo"]</label>
                            <div class="d-flex">
                                <input type="text"
                                       name="promoCode"
                                       value="@Model.PromoCode"
                                       class="form-control me-2"
                                       placeholder="@T["cart.code"]" />
                                <button type="submit" class="btn btn-custom-green">@T["shop.apply"]</button>
                            </div>
                        </form>

                        @if (!string.IsNullOrEmpty(Model.PromoCode) && Model.PromoDiscount > 0)
                        {
                            <form asp-action="RemovePromo" method="post" class="mb-3">
                                <button type="submit" class="btn btn-link p-0">@T["cart.removeCode"] @Model.PromoCode</button>
                            </form>
                        }

                        <dl class="row mb-0">
                            <dt class="col-6">@T["cart.subtotal"]</dt>
                            <dd class="col-6 text-end">@Model.SubTotal.Euro()</dd>

                            <dt class="col-6">@T["cart.discount"]</dt>
                            <dd class="col-6 text-end">-@Model.PromoDiscount.Euro()</dd>

                            <dt class="col-6">@T["cart.shipping"]</dt>
                            <dd class="col-6 text-end">
                                @if (Model.Shipping == 0)
                                {
                                    <span class="text-success">@T["cart.freeLabel"]</span>
                                }
                                else
                                {
                                    @Model.Shipping.Euro()
                                }
                            </dd>
                        </dl>

                        @if (Model.RemainingForFreeShipping > 0)
                        {
                            <p class="text-muted small mt-2 mb-0">
                                @T.Format("cart.remaining", Model.RemainingForFreeShipping.Euro(), Model.FreeShippingThreshold.Euro())
                            </p>
                        }

                        <hr />
                        <div class="d-flex justify-content-between h5 mb-3">
                            <span>@T["cart.total"]</span>
                            <strong>@Model.Total.Euro()</strong>
                        </div>

                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-success w-100 mb-2">
                            @T["cart.checkout"]
                        </a>
                        <a asp-controller="Item" asp-action="Index" class="btn btn-outline-secondary w-100">
                            @T["cart.continue"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
