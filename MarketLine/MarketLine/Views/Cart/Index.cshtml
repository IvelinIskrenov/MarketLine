@model MarketLine.Models.CartViewModel
@{
    ViewData["Title"] = "Количка";
}

<div class="container mt-4">
    <h1 class="mb-4 text-center">Количка</h1>

    @if (TempData["CartMessage"] != null)
    {
        <div class="alert alert-success text-center" role="alert">@TempData["CartMessage"]</div>
    }
    @if (TempData["CartError"] != null)
    {
        <div class="alert alert-warning text-center" role="alert">@TempData["CartError"]</div>
    }

    @if (Model.Lines.Count == 0)
    {
        <div class="alert alert-warning text-center" role="alert">
            Количката е празна.
        </div>
        <div class="text-center">
            <a asp-controller="Item" asp-action="Index" class="btn btn-custom-green">Към продуктите</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Продукт</th>
                            <th>Цена</th>
                            <th>Количество</th>
                            <th>Общо</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in Model.Lines)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(line.ImageUrl))
                                        {
                                            <img src="@line.ImageUrl" alt="@line.Name" style="width: 70px; height: 70px; object-fit: cover;" class="me-3 rounded" />
                                        }
                                        <a asp-controller="Item" asp-action="Details" asp-route-id="@line.ItemId" class="text-decoration-none text-dark">
                                            @line.Name
                                        </a>
                                    </div>
                                </td>
                                <td>@line.UnitPrice.ToString("C2")</td>
                                <td>
                                    <form asp-action="Update" method="post" class="d-flex align-items-center">
                                        <input type="hidden" name="id" value="@line.ItemId" />
                                        <input type="number"
                                               name="quantity"
                                               value="@line.Quantity"
                                               min="1"
                                               max="@line.StockQuantity"
                                               class="form-control"
                                               style="width: 80px;" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm ms-2">Обнови</button>
                                    </form>
                                </td>
                                <td>@line.LineTotal.ToString("C2")</td>
                                <td>
                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="id" value="@line.ItemId" />
                                        <button type="submit" class="btn btn-link text-danger p-0">Премахни</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h5 class="mb-3">Обобщение</h5>

                        <form asp-action="ApplyPromo" method="post" class="mb-3">
                            <label class="form-label">Промоционален код</label>
                            <div class="d-flex">
                                <input type="text"
                                       name="promoCode"
                                       value="@Model.PromoCode"
                                       class="form-control me-2"
                                       placeholder="Код" />
                                <button type="submit" class="btn btn-custom-green">Приложи</button>
                            </div>
                        </form>

                        @if (!string.IsNullOrEmpty(Model.PromoCode) && Model.PromoDiscount > 0)
                        {
                            <form asp-action="RemovePromo" method="post" class="mb-3">
                                <button type="submit" class="btn btn-link p-0">Премахни кода @Model.PromoCode</button>
                            </form>
                        }

                        <dl class="row mb-0">
                            <dt class="col-6">Междинна сума</dt>
                            <dd class="col-6 text-end">@Model.SubTotal.ToString("C2")</dd>

                            <dt class="col-6">Отстъпка</dt>
                            <dd class="col-6 text-end">-@Model.PromoDiscount.ToString("C2")</dd>

                            <dt class="col-6">Доставка</dt>
                            <dd class="col-6 text-end">
                                @if (Model.Shipping == 0)
                                {
                                    <span class="text-success">Безплатна</span>
                                }
                                else
                                {
                                    @Model.Shipping.ToString("C2")
                                }
                            </dd>
                        </dl>

                        @if (Model.RemainingForFreeShipping > 0)
                        {
                            <p class="text-muted small mt-2 mb-0">
                                Остават @Model.RemainingForFreeShipping.ToString("C2") до безплатна доставка над @Model.FreeShippingThreshold.ToString("C2").
                            </p>
                        }

                        <hr />
                        <div class="d-flex justify-content-between h5 mb-3">
                            <span>Общо</span>
                            <strong>@Model.Total.ToString("C2")</strong>
                        </div>

                        <a asp-controller="Item" asp-action="Index" class="btn btn-outline-secondary w-100">
                            Продължи пазаруването
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
