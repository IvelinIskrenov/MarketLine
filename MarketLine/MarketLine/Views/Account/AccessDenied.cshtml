@{
    ViewData["Title"] = T["account.deniedTitle"];
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <h1 class="mb-4 text-center">@T["account.deniedTitle"]</h1>
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 text-center">
                    <p class="mb-4">@T["account.deniedMsg"]</p>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-success">@T["account.home"]</a>
                </div>
            </div>
        </div>
    </div>
</div>
