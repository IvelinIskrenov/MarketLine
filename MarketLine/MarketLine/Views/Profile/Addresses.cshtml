@model MarketLine.Models.AddressesPageViewModel
@{
    ViewData["Title"] = "Адреси";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="mb-4 text-center">Моят профил</h1>
            <partial name="_ProfileNav" />

            @if (TempData["ProfileMessage"] != null)
            {
                <div class="alert alert-success text-center" role="alert">@TempData["ProfileMessage"]</div>
            }

            @if (Model.Addresses.Count == 0)
            {
                <div class="alert alert-warning text-center" role="alert">Нямате записани адреси.</div>
            }
            else
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">
                        @foreach (var address in Model.Addresses)
                        {
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <p class="mb-1">
                                        @if (!string.IsNullOrEmpty(address.Label))
                                        {
                                            <strong>@address.Label</strong>
                                        }
                                        @if (address.IsDefault)
                                        {
                                            <span class="badge bg-success">По подразбиране</span>
                                        }
                                    </p>
                                    <p class="mb-0">@address.AddressLine</p>
                                    <p class="mb-0">@address.PostalCode @address.City</p>
                                </div>
                                <div class="text-end">
                                    @if (!address.IsDefault)
                                    {
                                        <form asp-action="SetDefaultAddress" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@address.Id" />
                                            <button type="submit" class="btn btn-link p-0">Направи основен</button>
                                        </form>
                                    }
                                    <form asp-action="DeleteAddress" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@address.Id" />
                                        <button type="submit" class="btn btn-link text-danger p-0">Премахни</button>
                                    </form>
                                </div>
                            </div>
                            @if (address != Model.Addresses.Last())
                            {
                                <hr />
                            }
                        }
                    </div>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h5 class="mb-3">Нов адрес</h5>
                    <form asp-action="AddAddress" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="NewAddress.Label" class="form-label"></label>
                            <input asp-for="NewAddress.Label" class="form-control" placeholder="Дом, офис..." />
                        </div>
                        <div class="mb-3">
                            <label asp-for="NewAddress.AddressLine" class="form-label"></label>
                            <input asp-for="NewAddress.AddressLine" class="form-control" />
                            <span asp-validation-for="NewAddress.AddressLine" class="text-danger"></span>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="NewAddress.City" class="form-label"></label>
                                <input asp-for="NewAddress.City" class="form-control" />
                                <span asp-validation-for="NewAddress.City" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="NewAddress.PostalCode" class="form-label"></label>
                                <input asp-for="NewAddress.PostalCode" class="form-control" />
                                <span asp-validation-for="NewAddress.PostalCode" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="NewAddress.IsDefault" class="form-check-input" />
                            <label asp-for="NewAddress.IsDefault" class="form-check-label"></label>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success">Добави адрес</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
