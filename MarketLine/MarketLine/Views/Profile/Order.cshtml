@model MarketLine.Models.Order
@{
    ViewData["Title"] = "Поръчка " + Model.OrderNumber;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="mb-4 text-center">Моят профил</h1>
            <partial name="_ProfileNav" />

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-4">
                    <h5 class="mb-3">Поръчка @Model.OrderNumber</h5>
                    <p class="mb-3">Дата: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</p>

                    <h5 class="mb-3">Проследяване</h5>
                    <p class="mb-3">
                        Текущ статус:
                        <span class="badge @OrderStatuses.BadgeClass(Model.Status)">
                            @OrderStatuses.Normalize(Model.Status)
                        </span>
                    </p>
                    <partial name="_OrderTracker" model="Model" />

                    <h5 class="mb-3">Данни за доставка</h5>
                    <p class="mb-1">@Model.FirstName @Model.LastName</p>
                    <p class="mb-1">@Model.Address, @Model.PostalCode @Model.City</p>
                    <p class="mb-1">@Model.Phone · @Model.Email</p>
                    <p class="mb-1">@Model.Courier · @Model.DeliveryMethod</p>
                    <p class="mb-0">Плащане: @Model.PaymentMethod — @Model.PaymentStatus</p>
                </div>
            </div>

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Продукт</th>
                        <th>Количество</th>
                        <th>Общо</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>
                                @line.Name
                                @if (!string.IsNullOrWhiteSpace(line.VariantLabel))
                                {
                                    <div class="text-muted small">@line.VariantLabel</div>
                                }
                            </td>
                            <td>@line.Quantity</td>
                            <td>@line.LineTotal.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-between h5">
                <span>Платена сума</span>
                <strong>@Model.Total.ToString("C2")</strong>
            </div>

            <div class="text-center mt-4 d-flex flex-wrap justify-content-center gap-2">
                <partial name="_ReorderButton" model="Model" />
                <a asp-action="Orders" class="btn btn-outline-secondary">Назад към поръчките</a>
            </div>
        </div>
    </div>
</div>
