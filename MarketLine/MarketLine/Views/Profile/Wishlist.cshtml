@model List<MarketLine.Models.Item>
@{
    ViewData["Title"] = T["profile.wishlist"];
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="mb-4 text-center">@T["profile.mine"]</h1>
            <partial name="_ProfileNav" />

            @if (Model.Count == 0)
            {
                <div class="alert alert-warning text-center" role="alert">@T["profile.noWishlist"]</div>
            }
            else
            {
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>@T["cart.product"]</th>
                            <th>@T["cart.price"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.imageUrl))
                                        {
                                            <img src="@item.imageUrl" alt="@T.Content(item.name)" style="width: 70px; height: 70px; object-fit: cover;" class="me-3 rounded" />
                                        }
                                        <a asp-controller="Item" asp-action="Details" asp-route-id="@item.id" class="text-decoration-none text-dark">
                                            @T.Content(item.name)
                                        </a>
                                    </div>
                                </td>
                                <td>@item.DiscountedPrice.Euro()</td>
                                <td>
                                    <form asp-controller="Cart" asp-action="Add" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.id" />
                                        <button type="submit" class="btn btn-custom-green btn-sm">@T["shop.addToCart"]</button>
                                    </form>
                                    <form asp-action="ToggleWishlist" method="post" class="d-inline">
                                        <input type="hidden" name="itemId" value="@item.id" />
                                        <button type="submit" class="btn btn-link text-danger p-0">@T["cart.remove"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
