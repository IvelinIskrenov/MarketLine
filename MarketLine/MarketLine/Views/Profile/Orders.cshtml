@model List<MarketLine.Models.Order>
@{
    ViewData["Title"] = "Поръчки";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="mb-4 text-center">Моят профил</h1>
            <partial name="_ProfileNav" />

            @if (Model.Count == 0)
            {
                <div class="alert alert-warning text-center" role="alert">Нямате поръчки.</div>
            }
            else
            {
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Номер</th>
                            <th>Дата</th>
                            <th>Статус</th>
                            <th>Сума</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.OrderNumber</td>
                                <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td><span class="badge bg-success">@order.Status</span></td>
                                <td>@order.Total.ToString("C2")</td>
                                <td>
                                    <a asp-action="Order" asp-route-orderNumber="@order.OrderNumber">Проследи</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
