@model List<MarketLine.Models.Order>
@{
    ViewData["Title"] = T["profile.orders"];
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="mb-4 text-center">@T["profile.mine"]</h1>
            <partial name="_ProfileNav" />

            @if (Model.Count == 0)
            {
                <div class="alert alert-warning text-center" role="alert">@T["profile.noOrders"]</div>
            }
            else
            {
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>@T["order.number"]</th>
                            <th>@T["order.date"]</th>
                            <th>@T["order.status"]</th>
                            <th>@T["order.amount"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.OrderNumber</td>
                                <td>@order.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <span class="badge @OrderStatuses.BadgeClass(order.Status)">
                                        @T.Content(OrderStatuses.Normalize(order.Status))
                                    </span>
                                </td>
                                <td>@order.Total.Euro()</td>
                                <td>
                                    <a asp-action="Order" asp-route-orderNumber="@order.OrderNumber">@T["profile.track"]</a>
                                    <span class="ms-2">
                                        <partial name="_ReorderButton" model="order" />
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
