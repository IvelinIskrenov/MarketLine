@model MarketLine.Models.Item
@{
    var soldOutVariants = Model.Variants.Where(variant => variant.IsSoldOut).ToList();
    var showForm = Model.IsSoldOut || soldOutVariants.Count > 0;
    var email = User.Identity?.IsAuthenticated == true ? User.Identity?.Name : string.Empty;
}

@if (showForm)
{
    <div id="stock-alert" class="mt-3 p-3 border rounded bg-light">
        <p class="fw-semibold mb-2">Извести ме при наличност</p>
        <p class="text-muted small mb-3">Ще изпратим имейл, когато продуктът отново е на склад.</p>
        <form asp-controller="StockAlert" asp-action="Subscribe" method="post" class="row g-2 align-items-end">
            <input type="hidden" name="itemId" value="@Model.id" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
            @if (soldOutVariants.Count == 1)
            {
                <input type="hidden" name="variantId" value="@soldOutVariants[0].Id" />
            }
            else if (soldOutVariants.Count > 1)
            {
                <div class="col-md-4">
                    <label class="form-label" for="alert-variant">Вариант</label>
                    <select id="alert-variant" name="variantId" class="form-select">
                        @if (Model.IsSoldOut)
                        {
                            <option value="0">Когато има който и да е вариант</option>
                        }
                        @foreach (var variant in soldOutVariants)
                        {
                            <option value="@variant.Id">@variant.Label</option>
                        }
                    </select>
                </div>
            }
            <div class="col-md-5">
                <label class="form-label" for="alert-email">Имейл</label>
                <input id="alert-email"
                       type="email"
                       name="email"
                       class="form-control"
                       value="@email"
                       required
                       maxlength="256"
                       placeholder="you@email.com" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-custom-green w-100">Извести ме</button>
            </div>
        </form>
    </div>
}
