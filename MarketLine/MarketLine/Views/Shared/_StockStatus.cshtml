@model MarketLine.Models.Item

@if (Model.IsSoldOut)
{
    <span class="badge bg-danger">@T["shop.soldOut"]</span>
}
else if (Model.IsLowStock)
{
    <span class="badge bg-warning text-dark">@T["shop.lowStock"] (@Model.AvailableStock)</span>
}
else
{
    <span class="badge bg-success">@T["shop.inStock"] (@Model.AvailableStock)</span>
}
