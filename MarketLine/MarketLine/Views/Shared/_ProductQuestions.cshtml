@model MarketLine.Models.Item
@{
    var questions = ViewBag.Questions as IEnumerable<MarketLine.Models.ProductQuestion> ?? Enumerable.Empty<MarketLine.Models.ProductQuestion>();
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}

<div id="product-questions" class="mt-5">
    <h4 class="mb-3">@T["qa.title"]</h4>

    @if (!questions.Any())
    {
        <p class="text-muted">@T["qa.empty"]</p>
    }
    else
    {
        foreach (var current in questions)
        {
            <div class="border rounded p-3 mb-3 bg-light">
                <p class="mb-1">
                    <strong>@T["qa.question"]</strong>
                    <span class="text-muted small"> · @current.AuthorName · @current.AskedAt.ToString("dd.MM.yyyy")</span>
                </p>
                <p class="mb-2">@current.Question</p>
                @if (current.IsAnswered)
                {
                    <p class="mb-1"><strong>@T["qa.answer"]</strong></p>
                    <p class="mb-0">@current.Answer</p>
                }
                else
                {
                    <p class="text-muted mb-0">@T["qa.waiting"]</p>
                }
            </div>
        }
    }

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body">
            <h5 class="mb-3">@T["qa.ask"]</h5>
            <form asp-controller="ProductQuestion" asp-action="Ask" method="post">
                <input type="hidden" name="itemId" value="@Model.id" />
                @if (!isSignedIn)
                {
                    <div class="mb-3">
                        <label class="form-label" for="question-author">@T["qa.name"]</label>
                        <input id="question-author"
                               name="authorName"
                               class="form-control"
                               maxlength="50"
                               placeholder="@T["qa.namePlaceholder"]" />
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label" for="question-text">@T["qa.question"]</label>
                    <textarea id="question-text"
                              name="question"
                              class="form-control"
                              rows="3"
                              required
                              maxlength="500"
                              placeholder="@T["qa.placeholder"]"></textarea>
                </div>
                <button type="submit" class="btn btn-custom-green">@T["qa.submit"]</button>
            </form>
        </div>
    </div>
</div>
