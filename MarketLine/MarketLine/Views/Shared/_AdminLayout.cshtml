<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Админ панел</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #1e7e34;">
            <div class="container-fluid">
                <span class="navbar-brand fw-bold">MarketLine Админ</span>
                <div class="d-flex align-items-center gap-3">
                    <a class="btn btn-sm btn-outline-light" asp-controller="Home" asp-action="Index">Към магазина</a>
                    <a class="btn btn-sm btn-outline-light" asp-controller="Profile" asp-action="Index">Моят профил</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                        <button type="submit" class="btn btn-sm btn-light">Изход</button>
                    </form>
                </div>
            </div>
        </nav>
    </header>
    <div class="container py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
