@{
    string Css(string name) => ViewBag.AdminSection as string == name ? "btn-success" : "btn-outline-secondary";
}

<div class="text-center mb-4">
    <a asp-controller="Admin" asp-action="Index" class="btn @Css("Dashboard") btn-sm mb-1">@T["admin.dashboard"]</a>
    <a asp-controller="Item" asp-action="AdminControl" class="btn @Css("Products") btn-sm mb-1">@T["admin.products"]</a>
    <a asp-controller="Admin" asp-action="Categories" class="btn @Css("Categories") btn-sm mb-1">@T["admin.categories"]</a>
    <a asp-controller="Admin" asp-action="Orders" class="btn @Css("Orders") btn-sm mb-1">@T["admin.orders"]</a>
    <a asp-controller="Admin" asp-action="Reports" class="btn @Css("Reports") btn-sm mb-1">@T["admin.reports"]</a>
    <a asp-controller="Admin" asp-action="Inventory" class="btn @Css("Inventory") btn-sm mb-1">@T["admin.inventory"]</a>
    <a asp-controller="Admin" asp-action="StockAlerts" class="btn @Css("StockAlerts") btn-sm mb-1">@T["admin.alerts"]</a>
    <a asp-controller="Admin" asp-action="Questions" class="btn @Css("Questions") btn-sm mb-1">@T["admin.questions"]</a>
    <a asp-controller="Admin" asp-action="Tickets" class="btn @Css("Tickets") btn-sm mb-1">@T["admin.tickets"]</a>
    <a asp-controller="Admin" asp-action="Customers" class="btn @Css("Customers") btn-sm mb-1">@T["admin.customers"]</a>
    <a asp-controller="Admin" asp-action="Promotions" class="btn @Css("Promotions") btn-sm mb-1">@T["admin.promos"]</a>
    <a asp-controller="Admin" asp-action="Shipping" class="btn @Css("Shipping") btn-sm mb-1">@T["admin.shipping"]</a>
    <a asp-controller="Admin" asp-action="Payments" class="btn @Css("Payments") btn-sm mb-1">@T["admin.payments"]</a>
    <a asp-controller="Admin" asp-action="Content" class="btn @Css("Content") btn-sm mb-1">@T["admin.content"]</a>
    <a asp-controller="User" asp-action="Index" class="btn @Css("Users") btn-sm mb-1">@T["admin.users"]</a>
</div>
