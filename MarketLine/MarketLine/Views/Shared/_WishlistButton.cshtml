@model int
@{
    var ids = ViewBag.WishlistItemIds as HashSet<int> ?? new HashSet<int>();
    var isFavorite = ids.Contains(Model);
}

<form asp-controller="Profile" asp-action="ToggleWishlist" method="post" class="d-inline">
    <input type="hidden" name="itemId" value="@Model" />
    <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
    <button type="submit" class="btn btn-custom-green d-inline-flex align-items-center justify-content-center">
        @if (isFavorite)
        {
            <span class="me-2" style="color: #dc3545; font-weight: 700; line-height: 1;">&times;</span>
            <span>@T["shop.wishlist.remove"]</span>
        }
        else
        {
            <span class="me-2" style="font-weight: 700; line-height: 1;">+</span>
            <span>@T["shop.wishlist.add"]</span>
        }
    </button>
</form>
