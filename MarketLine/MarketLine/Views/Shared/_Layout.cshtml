<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketLine</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarketLine.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid">

                <!-- 1. LOGO -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    MarketLine
                </a>

                <!-- Mobile toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- LEFT SIDE -->
                    <ul class="navbar-nav align-items-center me-auto">

                        <!-- 2. CATEGORIES DROPDOWN -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center"
                               href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-list fs-4 me-1"></i> Категории
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Item" asp-action="Index" asp-route-category="Electronics">Електроника</a></li>
                                <li><a class="dropdown-item" asp-controller="Item" asp-action="Index" asp-route-category="Clothes">Дрехи</a></li>
                                <li><a class="dropdown-item" asp-controller="Item" asp-action="Index" asp-route-category="Food">Храни</a></li>
                            </ul>
                        </li>

                        <!-- 3. MESSAGE TEXT -->
                        <li class="nav-item ms-3">
                            <span class="navbar-text text-muted">
                                Безплатна доставка над 100 лв.
                            </span>
                        </li>
                    </ul>

                    <!-- RIGHT SIDE -->
                    <ul class="navbar-nav align-items-center">

                        <!-- 4. SEARCH ICON -->
                        <form class="search-form d-flex align-items-center" role="search">
                            <input type="search"
                                   class="form-control search-input"
                                   placeholder="Търси продукти..."
                                   aria-label="Search">
                            <button class="btn search-btn" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </form>


                        <!-- 5. CART ICON -->
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index">
                                <img src="~/images/cart.png" alt="Cart" style="width:30px; height:30px;">

                                <!-- OPTIONAL BADGE -->
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @ViewBag.CartCount
                                </span>
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - MarketLine - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
