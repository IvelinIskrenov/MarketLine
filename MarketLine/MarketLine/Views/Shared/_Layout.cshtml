<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MarketLine</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MarketLine.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container-fluid">

                <!-- 1. LOGO -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    MarketLine
                </a>

                <!-- Mobile toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- LEFT SIDE -->
                    <ul class="navbar-nav align-items-center me-auto">

                        <!-- 2. CATEGORIES DROPDOWN -->
                        <li class="nav-item dropdown">
                            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                                <ul class="navbar-nav flex-grow-1">
                                    @await Component.InvokeAsync("CategoryMenu")
                                </ul>
                            </div>
                        </li>
                        <!-- 3. MESSAGE TEXT -->
                        <li class="nav-item ms-3">
                            <div class="navbar-text text-muted">
                                Безплатна доставка над 100 лв.
                            </div>
                        </li>
                        <!-- 4. Farmacy consult -->
                        <li class="nav-item ms-3">
                            <div class="navbar-text text-muted">
                                Консултация с фармацевт
                            </div>
                        </li>
                        <li>
                            <a class="admin-control" asp-controller="Item" asp-action="AdminControl"> Продукти</a>
                        </li>
                        @if (User.Identity.IsAuthenticated && User.IsInRole("admin"))
                        {
                            <li>
                                <a class="user-control" asp-controller="User" asp-action="Index">Потребители</a>
                            </li>
                        }
                    </ul>

                    <!-- RIGHT SIDE -->
                    <ul class="navbar-nav align-items-center">

                        <!-- 4. SEARCH ICON -->
                        <form class="search-form d-flex align-items-center" role="search" method="get" asp-controller="Item" asp-action="Index">
                            <input type="search"
                                   name="searchTerm"
                                   class="form-control search-input"
                                   placeholder="Търси продукти..."
                                   aria-label="Search"
                                   value="@ViewData["CurrentSearch"]"> <button class="btn search-btn" type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </form>


                        <!-- 5. CART ICON -->
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index">
                                <img src="~/images/cart.png" alt="Cart" style="width:30px; height:30px;">

                                <!-- OPTIONAL BADGE -->
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                    @ViewBag.CartCount
                                </span>
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer id="footer">
        <div class="footerTop">
            <div class="wrapper">
                <div class="footerCol firstFooterCol">
                    <p><span class="footerColTitle">За MarketLine</span></p>
                    <ul>
                        <li><a href="/about">За нас</a></li>
                        <!--<li><a href="/karieri">Кариери</a></li>-->
                        <li><a href="/contacts">Контакти</a></li>
                    </ul>
                </div>
                <div class="footerCol footerPolicies">
                    <p><span class="footerColTitle">Политики</span></p>
                    <ul>
                        <li><a href="/obshti-uslovia">Общи условия</a></li>
                        <li><a href="/dostavka-i-plashtane">Доставка и плащане</a></li>
                        <li><a href="/zashtita-na-lichnite-danni">Защита на личните данни</a></li>
                    </ul>
                </div>
    </footer>
    <style>
        #footer {
            background-color: #f7f7f7; /* Very light gray background */
            border-top: 2px solid #ddd; /* Thin gray top border */
            color: #111; /* Dark gray/near black primary text color */
            padding: 20px 0; /* Vertical padding */
        }

        /* Section for columns */
        .footerTop .wrapper {
            display: flex; /* Arranges columns horizontally */
            justify-content: space-between; /* Evenly distributes space */
            max-width: 1200px; /* Limits content width */
            margin: 0 auto;
        }

        /* Styling for individual columns */
        .footerCol {
            width: 30%; /* Width of each column */
        }

        /* Column title */
        .footerColTitle {
            font-weight: bold;
            font-size: 1.1rem;
            color: #555; /* Medium gray color for titles */
            display: block;
            margin-bottom: 10px;
        }

        /* Styling for list items */
        .footerCol ul {
            list-style: none; /* Removes standard bullets/dots */
            padding: 0;
            margin: 0;
        }

            .footerCol ul li {
                margin-bottom: 5px;
            }

                .footerCol ul li a,
                .footerCol ul li span {
                    color: #666; /* Gray color for links */
                    text-decoration: none;
                    font-size: 0.95rem;
                }

                    .footerCol ul li a:hover,
                    .footerCol ul li span:hover {
                        color: #333; /* Darker gray on hover */
                        text-decoration: underline;
                    }
    </style>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
