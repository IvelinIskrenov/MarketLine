@model MarketLine.Models.Order
@{
    var status = OrderStatuses.Normalize(Model.Status);
    var currentStep = OrderStatuses.IndexOf(status);
}

@if (status == OrderStatuses.Cancelled)
{
    <div class="alert alert-danger text-center mb-4" role="alert">Поръчката е отказана.</div>
}
else
{
    <div class="d-flex justify-content-between flex-wrap gap-2 mb-4 order-steps">
        @for (var i = 0; i < OrderStatuses.Steps.Length; i++)
        {
            var step = OrderStatuses.Steps[i];
            <div class="text-center flex-fill">
                <span class="badge @(i <= currentStep ? "bg-success" : "bg-secondary")">@step</span>
            </div>
        }
    </div>
}
