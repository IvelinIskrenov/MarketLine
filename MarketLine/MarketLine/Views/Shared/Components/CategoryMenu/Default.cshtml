@model List<MarketLine.Models.Category>

<ul class="navbar-nav">
    <li class="nav-item dropdown">
        <a class="btn btn-custom-green dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            @T["nav.categories"]
        </a>
        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
            <li><a class="dropdown-item" asp-controller="Item" asp-action="Index" asp-route-category="">@T["shop.all"]</a></li>

            @foreach (var cat in Model)
            {
                <li>
                    <a class="dropdown-item"
                       asp-controller="Item"
                       asp-action="Index"
                       asp-route-category="@cat.Name">
                        @T.Content(cat.Name)
                    </a>
                </li>
            }
        </ul>
    </li>
</ul>
