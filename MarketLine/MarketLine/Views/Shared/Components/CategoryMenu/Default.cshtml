@model List<string>

<ul class="navbar-nav">
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-dark" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            Категории
        </a>
        <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
            <li><a class="dropdown-item" asp-controller="Item" asp-action="Index" asp-route-category="All">Всички</a></li>
            @foreach (var category in Model)
            {
                <li>
                    <a class="dropdown-item" asp-controller="Item" asp-action="Index" asp-route-category="@category">
                        @category
                    </a>
                </li>
            }
        </ul>
    </li>
</ul>